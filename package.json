{
    "name": "expr-calc",
    "version": "0.1.0",
    "description": "A command-line expression calculator",
    "type": "module",
    "imports": {
        "#*": {
            "development": "./src/*",
            "default": "./dist/*"
        }
    },
    "bin": {
        "expr-calc": "./dist/cli/index.js"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsx --conditions=development src/cli/index.ts",
        "start": "node dist/cli/index.js",
        "clean": "rm -rf dist coverage",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "^5.1.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.10.1",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.2",
        "vitest": "^5.1.0"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    },
    "overrides": { "minimatch": "^11.0.5" }
}
